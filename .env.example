# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
PORT=3000
# Per-visitor AI calls per day (0 = unlimited)
DAILY_AI_LIMIT=300
# Any long random string; salts the hashed visitor key used for the daily limit
SESSION_SECRET=change-me-to-a-long-random-string
# Optional backup AI, used when Gemini is busy or down (see the README):
# BACKUP_AI_KEY=the-providers-api-key
# BACKUP_AI_MODEL=the-model-name
# BACKUP_AI_BASE_URL=https://api.openai.com/v1
# BACKUP_AI_PROVIDER=anthropic    # use this instead of the two lines above for Claude
# Hosting on Netlify: a Postgres connection string (for example from neon.com). Leave unset to use local files.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
